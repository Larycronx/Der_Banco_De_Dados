
erDiagram
    FORNECEDOR ||--o{ COMPRA : "realiza"
    COMPRA ||--|{ ITEM_COMPRA : "possui"
    PRODUTO ||--o{ ITEM_COMPRA : "é comprado"
    PRODUTO ||--|| ESTOQUE : "possui saldo"
    PRODUTO ||--o{ MOVIMENTACAO_ESTOQUE : "movimenta"
    CLIENTE o|--o{ VENDA : "realiza"
    CANAL_VENDA ||--o{ VENDA : "origina"
    EVENTO o|--o{ VENDA : "ocorre em"
    VENDA ||--|{ ITEM_VENDA : "possui"
    PRODUTO ||--o{ ITEM_VENDA : "é vendido"
    FORNECEDOR o|--o{ CONTA_PAGAR : "recebe"
