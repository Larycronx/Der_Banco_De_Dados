    PRODUTO {
        int id_produto PK
        varchar nome
        categoria_produto_enum categoria
        tamanho_produto_enum tamanho
        cor_produto_enum cor
        decimal preco_venda
        boolean ativo
        decimal preco_unitario
        decimal custo_unitario
    }

    ESTOQUE {
        int id_estoque PK
        int id_produto FK
        int quantidade_atual
        int estoque_minimo
        datetime data_atualizacao
    }

    MOVIMENTACAO_ESTOQUE {
        int id_movimentacao PK
        int id_produto FK
        tipo_movimentacao_enum tipo_movimentacao
        int quantidade
        datetime data_movimentacao
        varchar motivo
    }

    FORNECEDOR {
        int id_fornecedor PK
        varchar razao_social
        char cnpj
        varchar telefone
        varchar email
    }

    COMPRA {
        int id_compra PK
        int id_fornecedor FK
        date data_compra
        decimal valor_total
        status_compra_enum status
    }

    ITEM_COMPRA {
        int id_compra PK, FK
        int id_produto PK, FK
        int quantidade
        decimal custo_unitario
    }

    CLIENTE {
        int id_cliente PK
        varchar nome
        varchar cpf
        varchar email
        varchar telefone
    }

    CANAL_VENDA {
        int id_canal PK
        varchar nome_canal
    }

    VENDA_SITE {
        int id_site PK
        int id_venda FK
        date data_compra
        date data_entrega
    }

    EVENTO {
        int id_evento PK
        varchar nome_evento
        varchar local_evento
        date data_inicio
        date data_fim
    }

    VENDA {
        int id_venda PK
        int id_cliente FK
        int id_canal FK
        int id_evento FK
        datetime data_venda
        decimal valor_total
        status_venda_enum status_venda
    }

    ITEM_VENDA {
        int id_venda PK, FK
        int id_produto PK, FK
        int quantidade
        decimal desconto
    }

    CONTA_PAGAR {
        int id_conta_pagar PK
        int id_fornecedor FK
        int id_compra FK
        varchar descricao
        decimal valor
        date data_emissao
        date data_vencimento
        date data_pagamento
        status_conta_pagar_enum status_conta
    }

    CONTA_RECEBER {
        int id_conta_receber PK
        int id_venda FK
        varchar descricao
        decimal valor
        date data_emissao
        date data_vencimento
        date data_recebimento
        status_conta_receber_enum status_conta_receber
    }

    PEDIDO_PRODUCAO {
        int id_pedido_producao PK
        int id_fornecedor FK
        date data_pedido
        date data_prevista
        date data_conclusao
        etapa_producao_enum etapa_atual
        status_producao_enum status_producao
    }

    ITEM_PEDIDO_PRODUCAO {
        int id_pedido_producao PK, FK
        int id_produto PK, FK
        int quantidade
    }

    CUSTO_EVENTO {
        int id_custo_evento PK
        int id_evento FK
        varchar descricao
        decimal valor
        date data_custo
    }

    PROMOCAO {
        int id_promocao PK
        varchar nome
        varchar tipo_desconto
        decimal valor_desconto
        date data_inicio
        date data_fim
        boolean ativa
    }

    ITEM_PROMOCAO {
        int id_promocao PK, FK
        int id_produto PK, FK
    }

    PERFIL_ACESSO {
        int id_perfil PK
        varchar nome
        varchar descricao
    }

    USUARIO {
        int id_usuario PK
        int id_perfil FK
        varchar nome
        varchar email
        varchar senha_hash
        boolean ativo
    }
