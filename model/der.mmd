    EVENTO o|--o{ VENDA : "ocorre em"
    VENDA ||--|{ ITEM_VENDA : "possui"
    PRODUTO ||--o{ ITEM_VENDA : "é vendido"
    FORNECEDOR ||--o{ CONTA_PAGAR : "recebe"
    COMPRA o|--o{ CONTA_PAGAR : "pode gerar"
    VENDA ||--o{ CONTA_RECEBER : "pode gerar"
    VENDA ||--o| VENDA_SITE : "possui dados do site"
